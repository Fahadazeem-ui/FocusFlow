<Window x:Class="FocusFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusFlow"
        Width="460" Height="640"
        MinWidth="420" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeep}"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border CornerRadius="18" BorderBrush="#1C2A45" BorderThickness="1" Background="{StaticResource BgDeep}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Border Grid.Row="0" Padding="18,14,14,10" Background="Transparent">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#00E5FF" Offset="0"/>
                                    <GradientStop Color="#007A99" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="FocusFlow" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource Cyan}" VerticalAlignment="Center"/>
                        <TextBlock Text="  v0.3" FontSize="11" Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" Margin="4,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="─" Style="{StaticResource GhostButton}" Width="32" Height="28"
                                Click="Minimize_Click" ToolTip="Minimize to tray" Margin="0,0,4,0"/>
                        <Button Content="✕" Style="{StaticResource GhostButton}" Width="32" Height="28"
                                Click="Close_Click" ToolTip="Exit (restores all processes)"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Margin="18,0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00E5FF" Offset="0"/>
                        <GradientStop Color="#A855F7" Offset="0.5"/>
                        <GradientStop Color="#FF2E97" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- BODY -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14,18,8">
                <StackPanel>

                    <!-- STATUS CARD -->
                    <Border Style="{StaticResource NeonCard}" Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect Color="#00E5FF" BlurRadius="18" ShadowDepth="0" Opacity="0.12"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="StatusLabel" Text="Focus Mode OFF"
                                           FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="FocusedAppText" Text="No app focused"
                                           FontSize="13" Foreground="{StaticResource TextSecondary}"
                                           Margin="0,6,0,0"/>
                                <TextBlock x:Name="StatsText" Text=""
                                           FontSize="12" Foreground="{StaticResource TextMuted}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <Ellipse x:Name="StatusOrb" Grid.Column="1" Width="42" Height="42"
                                     VerticalAlignment="Center" Margin="12,0,0,0">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop x:Name="OrbCenter" Color="#3A4558" Offset="0"/>
                                        <GradientStop x:Name="OrbEdge" Color="#1A2233" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect x:Name="OrbGlow" Color="#5A6A8A" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                    </Border>

                    <!-- PROFILES -->
                    <TextBlock Text="PROFILE" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}" Margin="2,0,0,8"/>
                    <StackPanel x:Name="ProfilePanel" Orientation="Horizontal" Margin="0,0,0,14"/>

                    <!-- FEATURE SUMMARY -->
                    <Border Style="{StaticResource NeonCard}" Margin="0,0,0,12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="ACTIVE PROFILE SETTINGS" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="EcoQoS" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="EcoQosValue" Grid.Column="1" FontSize="12" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Network throttle" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="NetValue" Grid.Column="1" FontSize="12" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="RAM trim" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="RamValue" Grid.Column="1" FontSize="12" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- LIVE THROTTLED LIST -->
                    <Border Style="{StaticResource NeonCard}" Margin="0,0,0,12" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="THROTTLED PROCESSES" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="LiveCountText" HorizontalAlignment="Right"
                                           FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            </Grid>
                            <Border Background="#0A101C" CornerRadius="8" Padding="10,8" MaxHeight="90">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="LiveListText" FontSize="12"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextWrapping="Wrap"
                                               Text="Start Focus Mode to see live list…"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- WHITELIST EDITOR -->
                    <Border Style="{StaticResource NeonCard}" Margin="0,0,0,12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="WHITELIST (never throttled)" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WhitelistInput" Height="30" FontSize="13"
                                         Background="#0A101C" Foreground="{StaticResource TextPrimary}"
                                         BorderBrush="#1E2A42" BorderThickness="1"
                                         Padding="8,5" VerticalContentAlignment="Center"
                                         CaretBrush="{StaticResource Cyan}"
                                         ToolTip="Process name without .exe  e.g. chrome"/>
                                <Button Grid.Column="1" Content="Add" Width="56" Height="30" Margin="8,0,0,0"
                                        Style="{StaticResource GhostButton}" Click="AddWhitelist_Click"
                                        Foreground="{StaticResource Cyan}"/>
                            </Grid>
                            <ItemsControl x:Name="WhitelistList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#121A2A" CornerRadius="12" Padding="10,4" Margin="0,0,6,6"
                                                BorderBrush="#1E2A42" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" FontSize="12"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           VerticalAlignment="Center"/>
                                                <Button Content="×" FontSize="12" Margin="6,0,0,0"
                                                        Foreground="{StaticResource TextMuted}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" Padding="2,0"
                                                        Click="RemoveWhitelist_Click"
                                                        Tag="{Binding}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- AUTO-START -->
                    <Border Style="{StaticResource NeonCard}" Padding="14" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Start with Windows" FontSize="13"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Launch FocusFlow at login (minimized to tray)"
                                           FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoStartBox" Grid.Column="1" VerticalAlignment="Center"
                                      Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- BOTTOM BAR -->
            <Border Grid.Row="2" Padding="18,12,18,18" Background="#080C16">
                <StackPanel>
                    <Button x:Name="ToggleBtn" Content="Start Focus Mode"
                            Style="{StaticResource NeonButton}" Height="46"
                            Click="Toggle_Click" FontSize="15">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00E5FF" Offset="0"/>
                                <GradientStop Color="#00B4D8" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <TextBlock Text="Exit restores every process and removes all QoS rules."
                               FontSize="10" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
